generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum TenantEventRole {
  OWNER
  EDITOR
  VIEWER
}

// ============================================
// SUPER ADMIN
// ============================================
model SuperAdmin {
  super_admin_id           String   @id @default(uuid())
  super_admin_name         String
  super_admin_phone_number String
  super_admin_email_id     String   @unique
  profile_url              String?
  role                     Role     @default(SUPER_ADMIN)
  isactive                 Boolean  @default(true)
  createdBy                String   @default("SYSTEM")
  createdAt                DateTime @default(now())
  updatedBy                String?
  updatedAt                DateTime @updatedAt

  login Login?
}

// ============================================
// TENANT
// ============================================
model Tenant {
  tenant_id             String    @id @default(uuid())
  tenant_name           String
  tenant_phone_number   String
  tenant_email_id       String    @unique
  tenant_studio_name    String
  tenant_studio_address String
  profile_url           String?
  role                  Role      @default(ADMIN)
  // One-time flag — the free trial is opt-in and can only ever be activated once per tenant.
  trial_activated_at    DateTime?
  isactive              Boolean   @default(true)
  createdBy             String    @default("SYSTEM")
  createdAt             DateTime  @default(now())
  updatedBy             String?
  updatedAt             DateTime  @updatedAt

  login                Login?
  event_mapping        EventTenantMapping[]
  tenant_settings      TenantSettings?
  created_users        User[]
  tenant_favourites    TenantFavouriteMediaMapping[]
  tenant_subscriptions TenantSubscription[]
  tenant_wallet        TenantWallet?
  wallet_transactions  WalletTransaction[]
  studio_services      StudioService[]
  quotations           Quotation[]
  bills                Bill[]
  payments             Payment[]
}

// ============================================
// USER
// ============================================
model User {
  user_id              String    @id @default(uuid())
  user_name            String
  user_phone_number    String?
  user_email_id        String?   @unique
  // Both null for a client that only exists for billing (quotations/bills) and
  // has not been granted gallery access to any event yet — a bare User row
  // with no Login. Set together, by createUserInEvent, the moment an admin
  // actually grants that access.
  validity_days        String?
  expiry_date          DateTime?
  profile_url          String?
  role                 Role      @default(USER)
  isactive             Boolean   @default(true)
  created_by_tenant_id String?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedBy            String?
  updatedAt            DateTime  @updatedAt

  login           Login?
  event_mapping   EventUserMapping[]
  favourite_media UserFavouriteMediaMapping[]
  created_by      Tenant?                     @relation(fields: [created_by_tenant_id], references: [tenant_id])
  quotations      Quotation[]
  bills           Bill[]

  @@index([created_by_tenant_id])
}

// ============================================
// LOGIN
// ============================================
model Login {
  transid               String    @id @default(uuid())
  username              String    @unique
  password_hash         String
  last_login_at         DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  role                  Role?
  isactive              Boolean   @default(true)
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedBy             String?
  updatedAt             DateTime  @updatedAt

  super_admin_id String? @unique
  tenant_id      String? @unique
  user_id        String? @unique

  super_admin SuperAdmin? @relation(fields: [super_admin_id], references: [super_admin_id])
  tenant      Tenant?     @relation(fields: [tenant_id], references: [tenant_id])
  user        User?       @relation(fields: [user_id], references: [user_id])
}

// ============================================
// EVENT
// ============================================
model Event {
  event_id                     String    @id @default(uuid())
  event_name                   String
  event_description            String?
  event_date                   DateTime?
  event_time                   String?
  event_venue                  String?
  event_organizer              String?
  event_organizer_phone_number String?
  event_organizer_email_id     String?
  profile_url                  String?
  // Snapshotted from the tenant's plan at creation time — an event either
  // gets a Photo Selection + AI Media pair, or Photo Selection only.
  is_ai_event                  Boolean   @default(false)
  // Set when the studio owner clicks "Publish Event". Informational for now —
  // will gate the AI face-matching/email step once that's built.
  published_at                 DateTime?
  // Studio opt-in per event: whether clients may download their photos.
  allow_download               Boolean   @default(true)
  isactive                     Boolean   @default(true)
  createdBy                    String
  createdAt                    DateTime  @default(now())
  updatedBy                    String?
  updatedAt                    DateTime  @updatedAt

  tenant_mapping    EventTenantMapping[]
  user_mapping      EventUserMapping[]
  media_stages      MediaUploadStage[]
  uploaded_media    UploadedMedia[]
  user_favourites   UserFavouriteMediaMapping[]
  tenant_favourites TenantFavouriteMediaMapping[]
  guests            EventGuest[]
}

// ============================================
// EVENT TENANT MAPPING
// ============================================
model EventTenantMapping {
  event_tenant_mapping_id String          @id @default(uuid())
  event_id                String
  tenant_id               String
  collaboration_role      TenantEventRole @default(OWNER)
  isactive                Boolean         @default(true)
  createdBy               String
  createdAt               DateTime        @default(now())
  updatedBy               String?
  updatedAt               DateTime        @updatedAt

  event  Event  @relation(fields: [event_id], references: [event_id])
  tenant Tenant @relation(fields: [tenant_id], references: [tenant_id])

  @@index([event_id])
  @@index([tenant_id])
  @@index([event_id, tenant_id])
}

// ============================================
// EVENT USER MAPPING
// ============================================
model EventUserMapping {
  event_user_id           String    @id @default(uuid())
  event_id                String
  user_id                 String
  isactive                Boolean   @default(true)
  access_expires          DateTime?
  // Max number of photos this client may favourite for this event. null = unlimited.
  favourite_limit         Int?
  // Set when the client (or the studio, on their behalf) submits their final
  // favourite selection for this event. Once set, favourites are frozen —
  // null = still editable.
  favourites_submitted_at DateTime?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedBy               String?
  updatedAt               DateTime  @updatedAt

  event Event @relation(fields: [event_id], references: [event_id])
  user  User  @relation(fields: [user_id], references: [user_id])

  @@index([event_id])
  @@index([user_id])
  @@index([event_id, user_id])
}

// ============================================
// EVENT GUEST (AI Media QR self-registration)
// ============================================
// A guest scans the event's QR code, uploads a selfie, and leaves their
// email. No login/account is created for them. Face-matching against
// AI Media photos and the resulting notification email are a later phase —
// this only captures the registration itself.
model EventGuest {
  event_guest_id     String   @id @default(uuid())
  event_id           String
  guest_email        String
  selfie_server_path String
  isactive           Boolean  @default(true)
  createdBy          String
  createdAt          DateTime @default(now())
  updatedBy          String?
  updatedAt          DateTime @updatedAt

  event Event @relation(fields: [event_id], references: [event_id])

  @@index([event_id])
}

// ============================================
// MEDIA UPLOAD STAGES
// ============================================
model MediaUploadStage {
  media_upload_stage_id          String    @id @default(uuid())
  event_id                       String
  media_name                     String
  media_type                     String
  media_size                     String
  media_upload_status            String    @default("Upload Just Started")
  media_upload_start             String    @default("0")
  media_upload_start_time        DateTime?
  media_uploaded                 String    @default("0")
  media_uploaded_time            DateTime?
  media_compressed               String    @default("0")
  media_compressed_time          DateTime?
  media_original_uploaded        String    @default("0")
  media_original_uploaded_time   DateTime?
  media_original_server_path     String    @default("Not Uploaded Yet")
  media_compressed_uploaded      String    @default("0")
  media_compressed_uploaded_time DateTime?
  media_compressed_server_path   String    @default("Not Uploaded Yet")
  isactive                       Boolean   @default(true)
  createdBy                      String
  createdAt                      DateTime  @default(now())
  updatedBy                      String?
  updatedAt                      DateTime  @updatedAt

  event          Event          @relation(fields: [event_id], references: [event_id])
  uploaded_media UploadedMedia?
}

// ============================================
// UPLOADED MEDIA
// ============================================
enum MediaGalleryType {
  PHOTO_SELECTION
  AI_MEDIA
}

model UploadedMedia {
  media_id               String           @id @default(uuid())
  event_id               String?
  media_upload_stage_id  String?          @unique
  media_name             String
  media_type             String
  media_size             String
  original_size          String?
  media_server_path      String
  compressed_server_path String
  // Photo Selection and AI Media are two separate galleries within the same
  // event. A "copy" between them creates a second row pointing at the SAME
  // stored file (see copyMediaToGallery) rather than duplicating storage.
  gallery_type           MediaGalleryType @default(PHOTO_SELECTION)
  isactive               Boolean          @default(true)
  createdBy              String
  createdAt              DateTime         @default(now())
  updatedBy              String?
  updatedAt              DateTime         @updatedAt

  event             Event?                        @relation(fields: [event_id], references: [event_id])
  upload_stages     MediaUploadStage?             @relation(fields: [media_upload_stage_id], references: [media_upload_stage_id])
  favourites        UserFavouriteMediaMapping[]
  tenant_favourites TenantFavouriteMediaMapping[]

  @@index([event_id, gallery_type])
}

// ============================================
// USER FAVOURITE MEDIA MAPPING
// ============================================
model UserFavouriteMediaMapping {
  user_favourite_media_id String   @id @default(uuid())
  event_id                String
  user_id                 String
  media_id                String
  isactive                Boolean  @default(true)
  createdBy               String
  createdAt               DateTime @default(now())
  updatedBy               String?
  updatedAt               DateTime @updatedAt

  event Event         @relation(fields: [event_id], references: [event_id])
  user  User          @relation(fields: [user_id], references: [user_id])
  media UploadedMedia @relation(fields: [media_id], references: [media_id])

  @@unique([event_id, user_id, media_id])
  @@index([event_id, user_id])
}

// ============================================
// TENANT SETTINGS
// ============================================
model TenantSettings {
  tenant_settings_id    String   @id @default(uuid())
  tenant_id             String?  @unique
  tenant_watermark_path String?
  // Brand colours — applied to the client-facing gallery (accent/gold theme)
  primary_color         String?
  secondary_color       String?
  // GST details shown on Quotation/Bill documents when set — display only,
  // no automatic tax calculation is done from these.
  gstin_number          String?
  gst_state             String?
  // Per-tenant sequential document numbering (Quotation #, Bill #, Receipt #).
  // Incremented atomically inside the same transaction that creates the
  // document, so "next" always reflects the number about to be issued.
  next_quotation_number Int      @default(1)
  next_bill_number      Int      @default(1)
  next_receipt_number   Int      @default(1)
  isactive              Boolean  @default(true)
  createdBy             String
  createdAt             DateTime @default(now())
  updatedBy             String?
  updatedAt             DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenant_id], references: [tenant_id])
}

// ============================================
// TENANT FAVOURITE MEDIA MAPPING
// ============================================
model TenantFavouriteMediaMapping {
  tenant_favourite_id String   @id @default(uuid())
  event_id            String
  tenant_id           String
  media_id            String
  isactive            Boolean  @default(true)
  createdBy           String
  createdAt           DateTime @default(now())
  updatedBy           String?
  updatedAt           DateTime @updatedAt

  event  Event         @relation(fields: [event_id], references: [event_id])
  tenant Tenant        @relation(fields: [tenant_id], references: [tenant_id])
  media  UploadedMedia @relation(fields: [media_id], references: [media_id])

  @@unique([event_id, tenant_id, media_id])
  @@index([event_id, tenant_id])
}

// ============================================
// JWT BLOCKLIST (invalidated tokens)
// ============================================
model TokenBlocklist {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ============================================
// SUBSCRIPTION PLANS + WALLET
// ============================================
enum PlanType {
  SUBSCRIPTION
  WALLET
}

enum DurationUnit {
  DAYS
  MONTHS
  YEARS
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  // Billing period ended but the renewal grace window hasn't lapsed yet —
  // uploads are blocked, existing photos/events stay visible.
  GRACE
  EXPIRED
  CANCELLED
}

enum WalletTransactionType {
  RECHARGE
  AI_USAGE
  ADJUSTMENT
}

// Only meaningful when plan_type = WALLET. INITIAL = the one-time first wallet
// purchase a tenant must make before they have a wallet at all; TOPUP = a
// recharge amount usable any number of times once the wallet already exists.
enum WalletTier {
  INITIAL
  TOPUP
}

model SubscriptionPlan {
  subscription_plan_id       String        @id @default(uuid())
  plan_name                  String
  plan_type                  PlanType
  duration_value             Int?
  duration_unit              DurationUnit?
  photo_quota                Int?
  price                      Decimal       @db.Decimal(10, 2)
  wallet_credits             Int?
  wallet_tier                WalletTier?
  ai_credit_cost_per_photo   Int?
  // A SUBSCRIPTION plan either includes the AI Media feature (guest QR
  // registration + a second gallery, matching handled in a later phase) or
  // is Photo Selection only. Irrelevant for WALLET plans.
  includes_ai_media          Boolean       @default(false)
  special_access_cutoff_date DateTime?
  display_order              Int           @default(0)
  isactive                   Boolean       @default(true)
  createdBy                  String
  createdAt                  DateTime      @default(now())
  updatedBy                  String?
  updatedAt                  DateTime      @updatedAt

  tenant_subscriptions TenantSubscription[]

  @@index([display_order])
}

// NOTE: a partial unique index `TenantSubscription_one_active_per_tenant`
// (tenant_id) WHERE isactive = true exists in the database (added via raw SQL
// migration — Prisma's schema DSL can't express a WHERE clause on a unique
// constraint). It guarantees a tenant can never have two active subscriptions
// at once, even if a check-then-act race (double-click, retry) slips past
// application-level guards. Do NOT let a future `prisma migrate diff` drop it.
model TenantSubscription {
  tenant_subscription_id String                   @id @default(uuid())
  tenant_id              String
  subscription_plan_id   String?
  status                 TenantSubscriptionStatus
  // What created this row — SUBSCRIBE | UPGRADE | DOWNGRADE | TRIAL | FREE_GRANT
  // (super admin free access). Lets the plan history show up/down grades
  // explicitly. Null on rows created before this column existed.
  change_type            String?
  locked_price           Decimal?                 @db.Decimal(10, 2)
  is_price_locked        Boolean                  @default(false)
  // Super Admin free grant: a chosen plan handed out free until a custom
  // expiry (e.g. 6 or 12 months) — locked_price is 0 and this flag lets the
  // UI tag it and lets revoke target exactly the grant row.
  is_free_grant          Boolean                  @default(false)
  photo_quota_total      Int
  photo_quota_used       Int                      @default(0)
  starts_at              DateTime                 @default(now())
  expires_at             DateTime?
  // Set once the billing period lapses without renewal (status flips to
  // GRACE) — when this passes too, the tenant's data is purged and status
  // becomes EXPIRED. Null while ACTIVE/TRIAL or for plans with no expiry.
  grace_ends_at          DateTime?
  isactive               Boolean                  @default(true)
  createdBy              String
  createdAt              DateTime                 @default(now())
  updatedBy              String?
  updatedAt              DateTime                 @updatedAt

  tenant Tenant            @relation(fields: [tenant_id], references: [tenant_id])
  plan   SubscriptionPlan? @relation(fields: [subscription_plan_id], references: [subscription_plan_id])

  @@index([tenant_id])
  @@index([tenant_id, isactive])
}

model TenantWallet {
  tenant_wallet_id String   @id @default(uuid())
  tenant_id        String   @unique
  balance_credits  Int      @default(0)
  isactive         Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedBy        String?
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [tenant_id])
}

model WalletTransaction {
  wallet_transaction_id String                @id @default(uuid())
  tenant_id             String
  type                  WalletTransactionType
  credits               Int
  balance_after         Int
  reference             String?
  notes                 String?
  isactive              Boolean               @default(true)
  createdBy             String
  createdAt             DateTime              @default(now())
  updatedBy             String?
  updatedAt             DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [tenant_id])

  @@index([tenant_id])
}

// Singleton row — platform-wide values a Super Admin can tune without a deploy.
model PlatformSettings {
  platform_settings_id String   @id @default(uuid())
  trial_duration_days  Int      @default(7)
  trial_photo_quota    Int      @default(200)
  // Grace window after a subscription's billing period ends, before its
  // events/photos are permanently purged for non-renewal.
  monthly_grace_days   Int      @default(3)
  yearly_grace_days    Int      @default(12)
  createdBy            String
  createdAt            DateTime @default(now())
  updatedBy            String?
  updatedAt            DateTime @updatedAt
}

// ============================================
// HELP & SUPPORT
// ============================================
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// `createdBy` (the audit-quartet convention used everywhere else in this
// schema) doubles as the ownership key here — it's the raiser's Login.transid,
// so "my tickets" is just `where: { createdBy: req.user.id }`. No separate
// tenant scoping: any authenticated role (SUPER_ADMIN/ADMIN/USER) can raise
// one, and only Super Admin manages/replies to the queue.
model SupportTicket {
  support_ticket_id String              @id @default(uuid())
  subject           String
  description       String
  status            SupportTicketStatus @default(OPEN)
  raised_by_role    Role
  raised_by_name    String
  isactive          Boolean             @default(true)
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedBy         String?
  updatedAt         DateTime            @updatedAt

  replies SupportTicketReply[]

  @@index([createdBy])
  @@index([status])
}

model SupportTicketReply {
  support_ticket_reply_id String   @id @default(uuid())
  support_ticket_id       String
  message                 String
  responder_role          Role
  responder_name          String
  createdBy               String
  createdAt               DateTime @default(now())

  ticket SupportTicket @relation(fields: [support_ticket_id], references: [support_ticket_id])

  @@index([support_ticket_id])
}

// ============================================
// BILLING — Phase 1: Services catalog, Billing Clients, Quotations
// (Bills, Payments/Receipts, GST-on-PDF follow in later phases)
// ============================================

// A studio's reusable catalog of services/products/packages, managed from
// their own Settings page — this is what populates "Add Items" on a quotation.
model StudioService {
  studio_service_id String   @id @default(uuid())
  tenant_id         String
  name              String
  price             Decimal? @db.Decimal(10, 2)
  isactive          Boolean  @default(true)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [tenant_id])

  @@index([tenant_id])
}

// LEGACY — superseded by User as the client record (see Quotation/Bill.user_id
// below), kept only so existing production rows created before that change
// keep their client name/contact intact. Never written to by new code.
// tenant_id intentionally has no back-relation on Tenant (not needed, avoids
// a second relation array nobody reads).
model BillingClient {
  billing_client_id String   @id @default(uuid())
  tenant_id         String
  name              String
  email             String?
  phone             String?
  isactive          Boolean  @default(true)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  quotations Quotation[]
  bills      Bill[]

  @@index([tenant_id])
}

enum QuotationStatus {
  DRAFT
  CONFIRMED
}

// The client is just a User — the same record used for gallery-login access.
// Creating a client purely for a quotation makes a bare User row (no Login,
// null validity_days/expiry_date); it only gains gallery access if/when an
// admin later assigns it to an event via the normal Access Board flow.
//
// user_id/client is optional and billing_client_id/billing_client is kept
// (nullable) purely for backward compatibility with rows created before
// this change — new code always sets user_id and leaves billing_client_id
// null. Read through resolveClient() (billingAccess.js) rather than either
// field directly, so both eras of data render identically.
model Quotation {
  quotation_id      String          @id @default(uuid())
  tenant_id         String
  user_id           String?
  billing_client_id String?
  // Per-tenant sequential number (the "Order No" / "Quotation #" shown to the studio).
  quotation_number  Int
  status            QuotationStatus @default(DRAFT)
  // Whole-quotation discount applied at the Confirm step (flat rupee amount).
  discount_amount   Decimal         @default(0) @db.Decimal(10, 2)
  isactive          Boolean         @default(true)
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedBy         String?
  updatedAt         DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenant_id], references: [tenant_id])
  client         User?           @relation(fields: [user_id], references: [user_id])
  billing_client BillingClient?  @relation(fields: [billing_client_id], references: [billing_client_id])
  items          QuotationItem[]
  bill           Bill?

  @@unique([tenant_id, quotation_number])
  @@index([tenant_id])
  @@index([user_id])
  @@index([billing_client_id])
}

model QuotationItem {
  quotation_item_id String   @id @default(uuid())
  quotation_id      String
  name              String
  price             Decimal  @db.Decimal(10, 2)
  quantity          Int      @default(1)
  // Flat rupee discount applied per unit (matches "Discount For Per Quantity" in the UI).
  discount_per_unit Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quotation Quotation @relation(fields: [quotation_id], references: [quotation_id])

  @@index([quotation_id])
}

// ============================================
// BILLING — Phase 2: Bills (generated from a confirmed Quotation)
// ============================================
enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Bills always originate from confirming a Quotation — line items are copied
// across at that moment so the Bill can then be edited independently (e.g.
// removing a package the client backed out of) without touching the source
// Quotation. Editable only while UNPAID — once a Payment (Phase 3) exists,
// the bill amount must stay fixed.
model Bill {
  bill_id           String     @id @default(uuid())
  tenant_id         String
  quotation_id      String     @unique
  user_id           String?
  billing_client_id String?
  // Per-tenant sequential number (the "Bill #" shown to the studio).
  bill_number       Int
  status            BillStatus @default(UNPAID)
  // Whole-bill discount (flat rupee amount) — independent of the quotation's
  // own discount_amount, since the studio may renegotiate at billing time.
  discount_amount   Decimal    @default(0) @db.Decimal(10, 2)
  isactive          Boolean    @default(true)
  createdBy         String
  createdAt         DateTime   @default(now())
  updatedBy         String?
  updatedAt         DateTime   @updatedAt

  tenant         Tenant         @relation(fields: [tenant_id], references: [tenant_id])
  quotation      Quotation      @relation(fields: [quotation_id], references: [quotation_id])
  client         User?          @relation(fields: [user_id], references: [user_id])
  billing_client BillingClient? @relation(fields: [billing_client_id], references: [billing_client_id])
  items          BillItem[]
  payments       Payment[]

  @@unique([tenant_id, bill_number])
  @@index([tenant_id])
  @@index([user_id])
  @@index([billing_client_id])
}

model BillItem {
  bill_item_id      String   @id @default(uuid())
  bill_id           String
  name              String
  price             Decimal  @db.Decimal(10, 2)
  quantity          Int      @default(1)
  discount_per_unit Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bill Bill @relation(fields: [bill_id], references: [bill_id])

  @@index([bill_id])
}

// ============================================
// BILLING — Phase 3: Payments (generate a Receipt against a Bill)
// ============================================
enum PaymentMethod {
  CASH
  GPAY
  CARD
  BANK_TRANSFER
  CHEQUE
}

// Each Payment IS a receipt (receipt_number is the "Receipt #" shown to the
// studio) — full or split/partial payments are just multiple Payment rows
// against the same Bill. Overpayment past the bill's payable amount is
// rejected at the controller level. Payments are immutable once created;
// correcting a mistake means the studio issues a matching negative-flow
// adjustment out of band (no edit/void endpoint in this phase).
model Payment {
  payment_id     String        @id @default(uuid())
  tenant_id      String
  bill_id        String
  // Per-tenant sequential number (the "Receipt #" printed on the receipt PDF).
  receipt_number Int
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  remark         String?
  isactive       Boolean       @default(true)
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedBy      String?
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [tenant_id])
  bill   Bill   @relation(fields: [bill_id], references: [bill_id])

  @@unique([tenant_id, receipt_number])
  @@index([tenant_id])
  @@index([bill_id])
}
